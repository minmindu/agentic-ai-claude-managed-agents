# Copy this file to .env and fill in your actual API keys.
# Never commit .env to version control.

# Anthropic (however, requred for Claude Managed Agent)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Tavily (for web search in research_tools)
TAVILY_API_KEY=your_tavily_api_key_here

# Other providers (add as needed)
# GOOGLE_API_KEY=your_google_api_key_here
# GROQ_API_KEY=your_groq_api_key_here


# ------------------------------------
# --- MongoDB (memory layer) ---
# ------------------------------------
# Atlas connection string. Required — memory.db.get_db() raises if unset.
DATABASE_URI=

# Database name. Optional — defaults to "research_agent" if unset.
DATABASE=research_agent

# Collection names. Optional — these defaults match what every example
# and test in this repo assumes. Only override if you need to run
# multiple environments (dev/staging) against the same database, or
# namespace collections for a multi-agent deployment.
COLLECTION_CONVERSATION=conversation
COLLECTION_CONVERSATION_SUMMARY=conversation_summary